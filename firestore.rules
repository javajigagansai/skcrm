rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users — require Firebase Auth to protect account management
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // All business data — open read/write
    // Security is enforced in the React app via RBAC (filterScopedRecords).
    // The login system uses a localStorage bypass that does not create a
    // Firebase Auth session, so request.auth is null for all logins.
    match /customers/{id} {
      allow read, write: if true;
    }
    match /policies/{id} {
      allow read, write: if true;
    }
    match /investments/{id} {
      allow read, write: if true;
    }
    match /claims/{id} {
      allow read, write: if true;
    }
    match /leads/{id} {
      allow read, write: if true;
    }
    match /followups/{id} {
      allow read, write: if true;
    }
    match /followup_hubs/{id} {
      allow read, write: if true;
    }
    match /spreadsheet_followups/{id} {
      allow read, write: if true;
    }
    match /tasks/{id} {
      allow read, write: if true;
    }
    match /income/{id} {
      allow read, write: if true;
    }
    match /expenses/{id} {
      allow read, write: if true;
    }
    match /audit_logs/{id} {
      allow read, write: if true;
    }
    match /notifications/{id} {
      allow read, write: if true;
    }

    // Catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
